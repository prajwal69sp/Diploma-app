rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "prajwalmarigowda69@gmail.com"
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // --- Validation Blueprints ---
    function isValidProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.role in ['student', 'admin'] &&
             (!('enrolledBranchId' in data) || data.enrolledBranchId == null || data.enrolledBranchId is string) &&
             (!('enrolledSemester' in data) || data.enrolledSemester == null || data.enrolledSemester is string);
    }

    function isValidBranch(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.description is string && data.description.size() <= 500 &&
             data.iconName is string &&
             data.displayOrder is number &&
             data.isEnabled is bool &&
             data.semesterCount is number;
    }

    function isValidSubject(data) {
      return data.branchId is string &&
             data.semester is string &&
             data.name is string && data.name.size() > 0 &&
             data.code is string &&
             data.description is string &&
             data.displayOrder is number &&
             data.isPublished is bool;
    }

    function isValidResource(data) {
      return data.subjectId is string &&
             data.type in ['notes', 'paper', 'video', 'quiz', 'important'] &&
             data.title is string && data.title.size() > 0 &&
             data.description is string &&
             data.fileUrl is string &&
             (!('youtubeUrl' in data) || data.youtubeUrl == null || data.youtubeUrl is string) &&
             data.displayOrder is number &&
             data.isPublished is bool;
    }

    // --- Collections ---

    match /profiles/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidProfile(incoming()) && 
                       incoming().role == 'student' &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;
      allow update: if isOwner(userId) && isValidProfile(incoming()) &&
                       incoming().role == existing().role &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'photoUrl', 'enrolledBranchId', 'enrolledSemester', 'updatedAt'
                       ]);
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via server/console or initial seed rule
    }

    match /branches/{branchId} {
      allow read: if isAdmin() || (incoming() == null && existing().isEnabled == true);
      allow write: if isAdmin() && isValidBranch(incoming());
    }

    match /subjects/{subjectId} {
      allow read: if isAdmin() || (incoming() == null && existing().isPublished == true);
      allow write: if isAdmin() && isValidSubject(incoming());
    }

    match /units/{unitId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /resources/{resourceId} {
      allow read: if isAdmin() || (incoming() == null && existing().isPublished == true);
      allow write: if isAdmin() && isValidResource(incoming());
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /app_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
